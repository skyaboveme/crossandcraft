---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';

// Import product data
import catalogData from '../content/products/catalog.json';

const featuredProducts = catalogData.filter((p: any) => p.featured);

---

<BaseLayout>
  <Header />

  <main>
    <!-- ===== HERO SECTION ===== -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden" style="background: linear-gradient(135deg, var(--color-deep-navy) 0%, var(--color-espresso) 50%, #3D2B2B 100%);">
      <!-- Decorative elements -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-20 left-10 w-72 h-72 rounded-full animate-float" style="background: radial-gradient(circle, var(--color-gold) 0%, transparent 70%);"></div>
        <div class="absolute bottom-20 right-10 w-96 h-96 rounded-full animate-float" style="background: radial-gradient(circle, var(--color-dusty-rose) 0%, transparent 70%); animation-delay: 1.5s;"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full" style="background: radial-gradient(circle, var(--color-sage) 0%, transparent 70%); opacity: 0.5;"></div>
      </div>

      <!-- Cross-stitch pattern overlay -->
      <div class="absolute inset-0 opacity-5" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 20px, rgba(255,255,255,0.1) 20px, rgba(255,255,255,0.1) 21px), repeating-linear-gradient(90deg, transparent, transparent 20px, rgba(255,255,255,0.1) 20px, rgba(255,255,255,0.1) 21px);"></div>

      <div class="relative z-10 max-w-4xl mx-auto px-4 text-center" style="padding-top: 8rem;">
        <div class="animate-fade-in-up">
          <span class="inline-block text-xs tracking-[0.4em] uppercase mb-6 px-6 py-2" style="color: var(--color-gold-light); border: 1px solid rgba(197, 165, 90, 0.3); font-family: var(--font-body);">
            Hand-Painted Needlepoint
          </span>
        </div>

        <h1 class="text-5xl md:text-7xl lg:text-8xl mb-6 leading-[0.95] animate-fade-in-up animate-fade-in-up-delay-1" style="font-family: var(--font-display); font-weight: 700; color: var(--color-cream);">
          The Art of the<br />
          <span class="text-gradient">Needle</span>
        </h1>

        <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto animate-fade-in-up animate-fade-in-up-delay-2" style="color: var(--color-warm-gray); font-family: var(--font-accent); font-style: italic; line-height: 1.6;">
          Exquisite hand-painted canvases crafted for stitchers who believe every thread tells a story.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-in-up animate-fade-in-up-delay-3">
          <a href="/shop" class="btn-primary">
            <span>Shop the Collection</span>
          </a>
          <a href="/about" class="btn-secondary" style="border-color: rgba(255,255,255,0.3); color: var(--color-cream);">
            Our Story
          </a>
        </div>

        <!-- Scroll indicator -->
        <div class="mt-20 animate-fade-in-up animate-fade-in-up-delay-4">
          <div class="w-px h-16 mx-auto" style="background: linear-gradient(to bottom, rgba(197, 165, 90, 0.5), transparent);"></div>
        </div>
      </div>
    </section>

    <!-- ===== FEATURED PRODUCTS ===== -->
    <section class="py-24 px-4" style="background-color: var(--color-cream);">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs tracking-[0.3em] uppercase mb-3 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">Curated For You</span>
          <h2 class="text-3xl md:text-5xl mb-4" style="font-family: var(--font-display); color: var(--color-espresso);">
            Featured Designs
          </h2>
          <div class="w-16 h-px mx-auto" style="background: linear-gradient(to right, transparent, var(--color-gold), transparent);"></div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {featuredProducts.map((product: any, i: number) => (
            <ProductCard
              title={product.title}
              slug={product.slug}
              price={product.price}
              comparePrice={product.comparePrice}
              image={product.image}
              category={product.category}
              designer={product.designer}
              inStock={product.inStock}
              featured={product.featured}
              index={i}
            />
          ))}
        </div>

        <div class="text-center mt-12">
          <a href="/shop" class="btn-secondary">
            View All Designs
          </a>
        </div>
      </div>
    </section>



    <!-- ===== ABOUT / STORY BANNER ===== -->
    <section class="py-24 px-4" style="background-color: var(--color-cream);">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Image placeholder -->
          <div class="aspect-[4/5] flex items-center justify-center" style="background: linear-gradient(135deg, var(--color-linen) 0%, var(--color-warm-gray) 100%);">
            <div class="text-center p-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4" style="color: var(--color-taupe);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
              </svg>
              <span class="text-xs uppercase tracking-widest" style="color: var(--color-taupe);">Brand Story Image</span>
            </div>
          </div>

          <!-- Text content -->
          <div>
            <span class="text-xs tracking-[0.3em] uppercase mb-4 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">Our Story</span>
            <h2 class="text-3xl md:text-4xl mb-6" style="font-family: var(--font-display); color: var(--color-espresso); line-height: 1.2;">
              Where Tradition Meets <span class="text-gradient">Modern Design</span>
            </h2>
            <p class="text-base leading-relaxed mb-6" style="color: var(--color-charcoal); font-family: var(--font-body);">
              At Cross & Craft Co., we believe needlepoint is more than a craft — it's an art form. Each of our hand-painted canvases is designed to inspire creativity and bring joy to every stitch.
            </p>
            <p class="text-base leading-relaxed mb-8" style="color: var(--color-charcoal); font-family: var(--font-body);">
              From classic chinoiserie to modern university collections, our designs are curated for stitchers who appreciate beautiful design and premium materials. Every kit includes everything you need to create your masterpiece.
            </p>
            <a href="/about" class="btn-primary">
              <span>Learn More</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== TRUST / FEATURES BAR ===== -->
    <section class="py-16 px-4" style="background-color: var(--color-deep-navy);">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
          <div class="p-6">
            <div class="text-2xl mb-3">🎨</div>
            <h3 class="text-sm font-semibold tracking-wider uppercase mb-2" style="font-family: var(--font-body); color: var(--color-cream);">Hand-Painted Canvases</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-warm-gray);">Every canvas is meticulously painted by skilled artisans, ensuring vibrant colors and precise details.</p>
          </div>
          <div class="p-6">
            <div class="text-2xl mb-3">📦</div>
            <h3 class="text-sm font-semibold tracking-wider uppercase mb-2" style="font-family: var(--font-body); color: var(--color-cream);">Complete Kits</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-warm-gray);">Our kits include canvas, threads, needle, and stitch guide. Everything you need, nothing you don't.</p>
          </div>
          <div class="p-6">
            <div class="text-2xl mb-3">💎</div>
            <h3 class="text-sm font-semibold tracking-wider uppercase mb-2" style="font-family: var(--font-body); color: var(--color-cream);">Premium Materials</h3>
            <p class="text-xs leading-relaxed" style="color: var(--color-warm-gray);">We source the finest Zweigart canvas, Appleton wool, and DMC cotton for a luxurious stitching experience.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== INSTAGRAM / SOCIAL CTA ===== -->
    <section class="py-24 px-4" style="background-color: var(--color-cream);">
      <div class="max-w-4xl mx-auto text-center">
        <span class="text-xs tracking-[0.3em] uppercase mb-3 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">Follow Along</span>
        <h2 class="text-3xl md:text-4xl mb-4" style="font-family: var(--font-display); color: var(--color-espresso);">
          @crossandcraftco
        </h2>
        <p class="text-base mb-8" style="color: var(--color-taupe); font-family: var(--font-accent); font-style: italic;">
          Share your stitches with #CrossAndCraftCo for a chance to be featured
        </p>

        <!-- Instagram grid placeholder -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-8">
          {[1, 2, 3, 4].map((i) => (
            <div class="aspect-square flex items-center justify-center group cursor-pointer overflow-hidden" style="background: linear-gradient(135deg, var(--color-linen) 0%, var(--color-warm-gray) 100%);">
              <div class="text-center group-hover:scale-110 transition-transform duration-300">
                <span class="text-3xl">✂️</span>
                <p class="text-[0.6rem] uppercase tracking-widest mt-2" style="color: var(--color-taupe);">Stitch #{i}</p>
              </div>
            </div>
          ))}
        </div>

        <a href="https://instagram.com/crossandcraftco" target="_blank" rel="noopener" class="btn-secondary">
          Follow on Instagram
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

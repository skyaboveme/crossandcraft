---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';

import catalogData from '../../content/products/catalog.json';

export function getStaticPaths() {
  return (catalogData as any[]).map((product: any) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const formattedPrice = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
}).format(product.price);

const formattedComparePrice = product.comparePrice
  ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(product.comparePrice)
  : null;

// Related products — same category, excluding self
const relatedProducts = (catalogData as any[])
  .filter((p: any) => p.category === product.category && p.slug !== product.slug)
  .slice(0, 4);
---

<BaseLayout
  title={`${product.title} | Cross & Craft Co.`}
  description={product.description}
>
  <Header />

  <main style="padding-top: 7rem;">
    <!-- ===== BREADCRUMB ===== -->
    <nav class="py-4 px-4" style="background-color: var(--color-ivory); border-bottom: 1px solid var(--color-linen);">
      <div class="max-w-7xl mx-auto">
        <ol class="flex items-center gap-2 text-xs" style="font-family: var(--font-body); color: var(--color-taupe);">
          <li><a href="/" class="hover:opacity-70 transition-opacity">Home</a></li>
          <li>›</li>
          <li><a href="/shop" class="hover:opacity-70 transition-opacity">Shop</a></li>
          <li>›</li>
          <li><a href={`/shop?category=${product.category.toLowerCase().replace(/\s+/g, '-')}`} class="hover:opacity-70 transition-opacity">{product.category}</a></li>
          <li>›</li>
          <li style="color: var(--color-espresso);">{product.title}</li>
        </ol>
      </div>
    </nav>

    <!-- ===== PRODUCT DETAIL ===== -->
    <section class="py-16 px-4" style="background-color: var(--color-cream);">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16">
          <!-- Image -->
          <div class="aspect-square flex items-center justify-center " style="background: linear-gradient(135deg, var(--color-linen) 0%, var(--color-warm-gray) 100%);">
            <div class="text-center p-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-20 w-20 mx-auto mb-4" style="color: var(--color-taupe);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
              </svg>
              <span class="text-xs uppercase tracking-widest" style="color: var(--color-taupe);">{product.title}</span>
            </div>
          </div>

          <!-- Details -->
          <div class="flex flex-col justify-center">
            <span class="text-xs tracking-[0.2em] uppercase mb-2" style="color: var(--color-gold); font-family: var(--font-body);">{product.category}</span>
            <h1 class="text-3xl md:text-4xl mb-4" style="font-family: var(--font-display); color: var(--color-espresso);">
              {product.title}
            </h1>

            {product.designer && (
              <p class="text-sm mb-4" style="color: var(--color-taupe); font-family: var(--font-accent); font-style: italic;">
                Designed by {product.designer}
              </p>
            )}

            <div class="flex items-baseline gap-3 mb-6">
              <span class="text-2xl font-semibold" style="font-family: var(--font-display); color: var(--color-espresso);">{formattedPrice}</span>
              {formattedComparePrice && (
                <span class="text-lg line-through" style="color: var(--color-taupe);">{formattedComparePrice}</span>
              )}
              {product.comparePrice && (
                <span class="badge badge-sale">Sale</span>
              )}
            </div>

            <p class="text-base leading-relaxed mb-8" style="color: var(--color-charcoal); font-family: var(--font-body);">
              {product.description}
            </p>

            <!-- Specs -->
            <div class="grid grid-cols-2 gap-4 mb-8 py-6" style="border-top: 1px solid var(--color-linen); border-bottom: 1px solid var(--color-linen);">
              {product.canvasSize && (
                <div>
                  <span class="text-[0.65rem] uppercase tracking-widest block mb-1" style="color: var(--color-taupe); font-family: var(--font-body);">Canvas Size</span>
                  <span class="text-sm font-medium" style="color: var(--color-espresso);">{product.canvasSize}</span>
                </div>
              )}
              {product.meshCount && (
                <div>
                  <span class="text-[0.65rem] uppercase tracking-widest block mb-1" style="color: var(--color-taupe); font-family: var(--font-body);">Mesh Count</span>
                  <span class="text-sm font-medium" style="color: var(--color-espresso);">{product.meshCount}</span>
                </div>
              )}
              <div>
                <span class="text-[0.65rem] uppercase tracking-widest block mb-1" style="color: var(--color-taupe); font-family: var(--font-body);">SKU</span>
                <span class="text-sm font-medium" style="color: var(--color-espresso);">{product.sku}</span>
              </div>
              <div>
                <span class="text-[0.65rem] uppercase tracking-widest block mb-1" style="color: var(--color-taupe); font-family: var(--font-body);">Availability</span>
                <span class="text-sm font-medium" style={`color: ${product.inStock ? 'var(--color-sage)' : 'var(--color-dusty-rose)'};`}>
                  {product.inStock ? '✓ In Stock' : 'Sold Out'}
                </span>
              </div>
            </div>

            <!-- Add to Cart -->
            {product.inStock ? (
              <button class="btn-primary w-full sm:w-auto">
                <span>Add to Cart</span>
              </button>
            ) : (
              <button class="btn-secondary w-full sm:w-auto opacity-50 cursor-not-allowed" disabled>
                Sold Out
              </button>
            )}

            <!-- Trust note -->
            <p class="text-xs mt-6" style="color: var(--color-taupe); font-family: var(--font-accent); font-style: italic;">
              Each kit includes hand-painted canvas, threads, needle & stitch guide.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== RELATED PRODUCTS ===== -->
    {relatedProducts.length > 0 && (
      <section class="py-16 px-4" style="background-color: var(--color-ivory);">
        <div class="max-w-7xl mx-auto">
          <div class="text-center mb-12">
            <span class="text-xs tracking-[0.3em] uppercase mb-3 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">You May Also Love</span>
            <h2 class="text-2xl md:text-3xl" style="font-family: var(--font-display); color: var(--color-espresso);">
              More {product.category}
            </h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {relatedProducts.map((rp: any, i: number) => (
              <ProductCard
                title={rp.title}
                slug={rp.slug}
                price={rp.price}
                comparePrice={rp.comparePrice}
                image={rp.image}
                category={rp.category}
                designer={rp.designer}
                inStock={rp.inStock}
                featured={rp.featured}
                index={i}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </main>

  <Footer />
</BaseLayout>

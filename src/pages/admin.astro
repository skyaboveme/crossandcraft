---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin | Cross & Craft Co." description="Admin panel for managing Cross & Craft Co. content.">

<!-- ===== LOGIN SCREEN ===== -->
<div id="login-screen" class="admin-login-screen">
  <div class="admin-login-card">
    <div class="admin-login-brand">
      <span class="admin-login-eyebrow">Cross & Craft Co.</span>
      <h1 class="admin-login-title">Admin Panel</h1>
      <div class="admin-login-divider"></div>
      <p class="admin-login-subtitle">Enter your password to manage site content</p>
    </div>
    <form id="login-form" class="admin-login-form">
      <div class="admin-input-group">
        <label for="admin-password" class="admin-label">Password</label>
        <input type="password" id="admin-password" class="admin-input" placeholder="Enter admin password" autocomplete="current-password" required />
      </div>
      <button type="submit" class="admin-btn-login">
        <span>Sign In</span>
      </button>
      <p id="login-error" class="admin-login-error" style="display:none;">Invalid password. Please try again.</p>
    </form>
    <a href="/" class="admin-back-link">← Back to site</a>
  </div>
</div>

<!-- ===== ADMIN DASHBOARD ===== -->
<div id="admin-dashboard" class="admin-dashboard" style="display:none;">

  <!-- Top Bar -->
  <header class="admin-topbar">
    <div class="admin-topbar-inner">
      <div class="admin-topbar-brand">
        <span class="admin-topbar-logo">C&C</span>
        <span class="admin-topbar-title">Admin Dashboard</span>
      </div>
      <div class="admin-topbar-actions">
        <a href="/" class="admin-topbar-link">View Site</a>
        <button id="logout-btn" class="admin-topbar-logout">Sign Out</button>
      </div>
    </div>
  </header>

  <!-- Tab Navigation -->
  <nav class="admin-tabs">
    <button class="admin-tab active" data-tab="products">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
      Products
    </button>
    <button class="admin-tab" data-tab="updates">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
      Site Updates
    </button>
    <button class="admin-tab" data-tab="images">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      Images
    </button>
  </nav>

  <!-- ===== PRODUCTS TAB ===== -->
  <div id="tab-products" class="admin-tab-content active">
    <div class="admin-section-header">
      <div>
        <h2 class="admin-section-title">Product Catalog</h2>
        <p class="admin-section-desc">Manage your needlepoint product listings</p>
      </div>
      <div class="admin-section-actions">
        <button id="add-product-btn" class="admin-btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
          Add Product
        </button>
        <button id="export-catalog-btn" class="admin-btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Export JSON
        </button>
      </div>
    </div>

    <!-- Product List -->
    <div id="products-list" class="admin-products-list">
      <!-- Populated by JS -->
    </div>
  </div>

  <!-- ===== SITE UPDATES TAB ===== -->
  <div id="tab-updates" class="admin-tab-content">
    <div class="admin-section-header">
      <div>
        <h2 class="admin-section-title">Site Updates</h2>
        <p class="admin-section-desc">Type changes and updates you'd like to make to the site</p>
      </div>
      <div class="admin-section-actions">
        <button id="export-updates-btn" class="admin-btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Export Updates
        </button>
      </div>
    </div>

    <!-- New Update Form -->
    <div class="admin-card" style="margin-bottom: 1.5rem;">
      <h3 class="admin-card-title">New Update</h3>
      <div class="admin-input-group">
        <label for="update-title" class="admin-label">Title</label>
        <input type="text" id="update-title" class="admin-input" placeholder='e.g. "Update homepage hero text"' />
      </div>
      <div class="admin-input-group">
        <label for="update-description" class="admin-label">Description</label>
        <textarea id="update-description" class="admin-textarea" rows="4" placeholder="Describe the change you'd like to make..."></textarea>
      </div>
      <div class="admin-input-group">
        <label for="update-priority" class="admin-label">Priority</label>
        <select id="update-priority" class="admin-select">
          <option value="low">Low</option>
          <option value="medium" selected>Medium</option>
          <option value="high">High</option>
        </select>
      </div>
      <button id="add-update-btn" class="admin-btn-primary" style="margin-top: 0.5rem;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
        Add Update
      </button>
    </div>

    <!-- Updates List -->
    <div id="updates-list" class="admin-updates-list">
      <!-- Populated by JS -->
    </div>
  </div>

  <!-- ===== IMAGES TAB ===== -->
  <div id="tab-images" class="admin-tab-content">
    <div class="admin-section-header">
      <div>
        <h2 class="admin-section-title">Image Manager</h2>
        <p class="admin-section-desc">Upload images to the public folder</p>
      </div>
      <div class="admin-section-actions">
        <button id="download-all-images-btn" class="admin-btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          Download All
        </button>
      </div>
    </div>

    <!-- Drop Zone -->
    <div id="drop-zone" class="admin-dropzone">
      <div class="admin-dropzone-content">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="admin-dropzone-icon"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
        <p class="admin-dropzone-title">Drag & drop images here</p>
        <p class="admin-dropzone-subtitle">or click to browse</p>
        <input type="file" id="image-file-input" class="admin-dropzone-input" multiple accept="image/*" />
      </div>
    </div>

    <!-- Subfolder selector -->
    <div class="admin-card" style="margin-top: 1.5rem; margin-bottom: 1.5rem;">
      <div class="admin-input-group" style="margin-bottom: 0;">
        <label for="image-subfolder" class="admin-label">Target Folder</label>
        <select id="image-subfolder" class="admin-select">
          <option value="/images/">/images/</option>
          <option value="/images/products/">/images/products/</option>
          <option value="/images/gallery/">/images/gallery/</option>
          <option value="/images/about/">/images/about/</option>
        </select>
      </div>
    </div>

    <!-- Uploaded Images Gallery -->
    <div id="uploaded-images" class="admin-image-gallery">
      <!-- Populated by JS -->
    </div>
  </div>

</div>

<!-- ===== PRODUCT EDIT MODAL ===== -->
<div id="product-modal" class="admin-modal" style="display:none;">
  <div class="admin-modal-backdrop"></div>
  <div class="admin-modal-content">
    <div class="admin-modal-header">
      <h2 id="modal-title" class="admin-modal-title">Add Product</h2>
      <button id="modal-close-btn" class="admin-modal-close">&times;</button>
    </div>
    <form id="product-form" class="admin-modal-body">
      <input type="hidden" id="product-index" value="-1" />

      <div class="admin-form-grid">
        <div class="admin-input-group admin-form-full">
          <label for="product-title" class="admin-label">Title *</label>
          <input type="text" id="product-title" class="admin-input" placeholder="Product name" required />
        </div>

        <div class="admin-input-group">
          <label for="product-slug" class="admin-label">Slug *</label>
          <input type="text" id="product-slug" class="admin-input" placeholder="product-slug" required />
        </div>

        <div class="admin-input-group">
          <label for="product-sku" class="admin-label">SKU *</label>
          <input type="text" id="product-sku" class="admin-input" placeholder="CC-XX-000" required />
        </div>

        <div class="admin-input-group admin-form-full">
          <label for="product-description" class="admin-label">Description *</label>
          <textarea id="product-description" class="admin-textarea" rows="3" placeholder="Product description..." required></textarea>
        </div>

        <div class="admin-input-group">
          <label for="product-price" class="admin-label">Price *</label>
          <input type="number" id="product-price" class="admin-input" placeholder="0.00" step="0.01" min="0" required />
        </div>

        <div class="admin-input-group">
          <label for="product-compare-price" class="admin-label">Compare Price</label>
          <input type="number" id="product-compare-price" class="admin-input" placeholder="Optional" step="0.01" min="0" />
        </div>

        <div class="admin-input-group">
          <label for="product-category" class="admin-label">Category *</label>
          <input type="text" id="product-category" class="admin-input" placeholder="e.g. Florals" required />
        </div>

        <div class="admin-input-group">
          <label for="product-designer" class="admin-label">Designer</label>
          <input type="text" id="product-designer" class="admin-input" placeholder="Cross & Craft Co." />
        </div>

        <div class="admin-input-group">
          <label for="product-canvas-size" class="admin-label">Canvas Size</label>
          <input type="text" id="product-canvas-size" class="admin-input" placeholder='e.g. 14" x 14"' />
        </div>

        <div class="admin-input-group">
          <label for="product-mesh-count" class="admin-label">Mesh Count</label>
          <input type="text" id="product-mesh-count" class="admin-input" placeholder="e.g. 18 mesh" />
        </div>

        <div class="admin-input-group">
          <label for="product-tags" class="admin-label">Tags</label>
          <input type="text" id="product-tags" class="admin-input" placeholder="Comma-separated tags" />
        </div>

        <div class="admin-input-group">
          <label for="product-image" class="admin-label">Image Path</label>
          <input type="text" id="product-image" class="admin-input" placeholder="/images/products/filename.jpg" />
        </div>

        <div class="admin-input-group admin-form-full">
          <label class="admin-label">Upload Image</label>
          <div class="admin-file-upload">
            <input type="file" id="product-image-upload" accept="image/*" />
            <div id="product-image-preview" class="admin-image-preview"></div>
          </div>
        </div>

        <div class="admin-input-group admin-form-checkboxes">
          <label class="admin-checkbox-label">
            <input type="checkbox" id="product-in-stock" checked />
            <span>In Stock</span>
          </label>
          <label class="admin-checkbox-label">
            <input type="checkbox" id="product-featured" />
            <span>Featured</span>
          </label>
        </div>
      </div>

      <div class="admin-modal-footer">
        <button type="button" id="modal-cancel-btn" class="admin-btn-secondary">Cancel</button>
        <button type="submit" class="admin-btn-primary">
          <span id="modal-submit-text">Save Product</span>
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ===== TOAST ===== -->
<div id="toast" class="admin-toast" style="display:none;"></div>

</BaseLayout>

<style>
/* ===== ADMIN: LOGIN ===== */
.admin-login-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-deep-navy) 0%, var(--color-espresso) 60%, #3D2B2B 100%);
  position: relative;
  overflow: hidden;
  padding: 2rem;
}
.admin-login-screen::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle at 30% 70%, rgba(197, 165, 90, 0.06) 0%, transparent 50%),
              radial-gradient(circle at 70% 30%, rgba(196, 146, 154, 0.04) 0%, transparent 50%);
  animation: float 6s ease-in-out infinite;
}
.admin-login-card {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 420px;
  background: rgba(27, 40, 56, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 3rem 2.5rem;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
}
.admin-login-brand {
  text-align: center;
  margin-bottom: 2rem;
}
.admin-login-eyebrow {
  font-family: var(--font-body);
  font-size: 0.7rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-gold);
}
.admin-login-title {
  font-family: var(--font-display);
  font-size: 2rem;
  color: var(--color-cream);
  margin: 0.5rem 0;
}
.admin-login-divider {
  width: 3rem;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--color-gold), transparent);
  margin: 1rem auto;
}
.admin-login-subtitle {
  font-family: var(--font-accent);
  font-style: italic;
  font-size: 0.9rem;
  color: var(--color-warm-gray);
}
.admin-login-form {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.admin-login-error {
  text-align: center;
  font-size: 0.8rem;
  color: var(--color-dusty-rose);
  margin: 0;
}
.admin-btn-login {
  width: 100%;
  padding: 0.875rem;
  background: linear-gradient(135deg, var(--color-gold) 0%, #B8943D 100%);
  color: var(--color-espresso);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.admin-btn-login:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 25px rgba(197, 165, 90, 0.3);
}
.admin-back-link {
  display: block;
  text-align: center;
  margin-top: 1.5rem;
  font-size: 0.8rem;
  color: var(--color-warm-gray);
  text-decoration: none;
  transition: color 0.2s;
}
.admin-back-link:hover {
  color: var(--color-gold);
}

/* ===== ADMIN: SHARED FORM ELEMENTS ===== */
.admin-label {
  display: block;
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--color-warm-gray);
  margin-bottom: 0.375rem;
}
.admin-input,
.admin-textarea,
.admin-select {
  width: 100%;
  padding: 0.75rem 1rem;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: var(--color-cream);
  font-family: var(--font-body);
  font-size: 0.9rem;
  transition: border-color 0.2s, box-shadow 0.2s;
  box-sizing: border-box;
}
.admin-input:focus,
.admin-textarea:focus,
.admin-select:focus {
  outline: none;
  border-color: var(--color-gold);
  box-shadow: 0 0 0 3px rgba(197, 165, 90, 0.15);
}
.admin-input::placeholder,
.admin-textarea::placeholder {
  color: rgba(212, 207, 199, 0.4);
}
.admin-select option {
  background: var(--color-deep-navy);
  color: var(--color-cream);
}
.admin-input-group {
  margin-bottom: 1rem;
}
.admin-textarea {
  resize: vertical;
  min-height: 80px;
}

/* ===== ADMIN: DASHBOARD ===== */
.admin-dashboard {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-deep-navy) 0%, #151E2B 100%);
  color: var(--color-cream);
}

/* Top Bar */
.admin-topbar {
  background: rgba(27, 40, 56, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 0 1.5rem;
  height: 64px;
  position: sticky;
  top: 0;
  z-index: 100;
}
.admin-topbar-inner {
  max-width: 1280px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}
.admin-topbar-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.admin-topbar-logo {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-gold) 0%, #B8943D 100%);
  color: var(--color-espresso);
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 0.85rem;
  border-radius: 8px;
}
.admin-topbar-title {
  font-family: var(--font-body);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--color-cream);
}
.admin-topbar-actions {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.admin-topbar-link {
  font-family: var(--font-body);
  font-size: 0.8rem;
  color: var(--color-warm-gray);
  text-decoration: none;
  transition: color 0.2s;
}
.admin-topbar-link:hover { color: var(--color-gold); }
.admin-topbar-logout {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 0.5rem 1rem;
  background: rgba(196, 146, 154, 0.15);
  color: var(--color-dusty-rose-light);
  border: 1px solid rgba(196, 146, 154, 0.2);
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
}
.admin-topbar-logout:hover {
  background: rgba(196, 146, 154, 0.25);
}

/* Tabs */
.admin-tabs {
  display: flex;
  gap: 0.25rem;
  max-width: 1280px;
  margin: 0 auto;
  padding: 1.5rem 1.5rem 0;
}
.admin-tab {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.03em;
  color: var(--color-warm-gray);
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  transition: all 0.2s;
}
.admin-tab:hover {
  color: var(--color-cream);
}
.admin-tab.active {
  color: var(--color-gold);
  border-bottom-color: var(--color-gold);
}

/* Tab Content */
.admin-tab-content {
  display: none;
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
}
.admin-tab-content.active {
  display: block;
}

/* Section Header */
.admin-section-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 2rem;
  flex-wrap: wrap;
  gap: 1rem;
}
.admin-section-title {
  font-family: var(--font-display) !important;
  font-size: 1.75rem !important;
  color: var(--color-cream) !important;
  margin: 0;
}
.admin-section-desc {
  font-size: 0.85rem;
  color: var(--color-warm-gray);
  margin: 0.25rem 0 0;
  font-family: var(--font-accent);
  font-style: italic;
}
.admin-section-actions {
  display: flex;
  gap: 0.75rem;
  flex-wrap: wrap;
}

/* Buttons */
.admin-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  background: linear-gradient(135deg, var(--color-gold) 0%, #B8943D 100%);
  color: var(--color-espresso);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.3s ease;
}
.admin-btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 20px rgba(197, 165, 90, 0.25);
}
.admin-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.625rem 1.25rem;
  background: rgba(255, 255, 255, 0.06);
  color: var(--color-cream);
  font-family: var(--font-body);
  font-size: 0.8rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  text-transform: uppercase;

</style>

<script>
  // ===== CONFIGURATION =====
  const ADMIN_PASSWORD = 'crosscraft2024';

  // ===== STATE =====
  let products: any[] = [];
  let siteUpdates: any[] = [];
  let uploadedImages: { name: string; data: string; size: number; folder: string }[] = [];

  // ===== DOM REFS =====
  const loginScreen = document.getElementById('login-screen')!;
  const dashboard = document.getElementById('admin-dashboard')!;
  const loginForm = document.getElementById('login-form')!;
  const loginError = document.getElementById('login-error')!;
  const passwordInput = document.getElementById('admin-password') as HTMLInputElement;

  // ===== HELPERS =====
  function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
    const toast = document.getElementById('toast')!;
    toast.textContent = message;
    toast.className = `admin-toast ${type}`;
    toast.style.display = 'block';
    setTimeout(() => { toast.style.display = 'none'; }, 3000);
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  function slugify(text: string): string {
    return text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }

  // ===== AUTH =====
  function showDashboard() {
    loginScreen.style.display = 'none';
    dashboard.style.display = 'block';
    loadProducts();
    loadUpdates();
  }

  if (sessionStorage.getItem('adminLoggedIn') === 'true') {
    showDashboard();
  }

  loginForm.addEventListener('submit', (e) => {
    e.preventDefault();
    if (passwordInput.value === ADMIN_PASSWORD) {
      sessionStorage.setItem('adminLoggedIn', 'true');
      showDashboard();
    } else {
      loginError.style.display = 'block';
      passwordInput.value = '';
      passwordInput.focus();
    }
  });

  document.getElementById('logout-btn')!.addEventListener('click', () => {
    sessionStorage.removeItem('adminLoggedIn');
    loginScreen.style.display = '';
    dashboard.style.display = 'none';
    passwordInput.value = '';
    loginError.style.display = 'none';
  });

  // ===== TABS =====
  document.querySelectorAll('.admin-tab').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.admin-tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      const target = tab.getAttribute('data-tab')!;
      document.getElementById(`tab-${target}`)!.classList.add('active');
    });
  });

  // ===== PRODUCTS =====
  async function loadProducts() {
    try {
      // Fetch the raw catalog JSON from the content directory via the dev server
      // Since catalog.json is in src/content/products/, we fetch via a known data endpoint
      // For static admin, we'll use an inline approach: fetch the page data
      const response = await fetch('/data/catalog.json');
      if (response.ok) {
        products = await response.json();
      }
    } catch {
      // Fallback: try to parse from the page or start empty
      products = [];
    }
    renderProducts();
  }

  function renderProducts() {
    const list = document.getElementById('products-list')!;
    if (products.length === 0) {
      list.innerHTML = `
        <div class="admin-empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          <p>No products yet. Click "Add Product" to get started.</p>
        </div>
      `;
      return;
    }

    list.innerHTML = products.map((p: any, i: number) => {
      const badges = [];
      if (p.featured) badges.push('<span class="admin-product-badge featured">Featured</span>');
      if (!p.inStock) badges.push('<span class="admin-product-badge out-of-stock">Out of Stock</span>');

      return `
        <div class="admin-product-row">
          <div class="admin-product-thumb">
            ${p.image ? `<img src="${p.image}" alt="${p.title}" onerror="this.parentElement.innerHTML='<span class=\\'admin-product-thumb-placeholder\\'>🧵</span>'" />` : '<span class="admin-product-thumb-placeholder">🧵</span>'}
          </div>
          <div class="admin-product-info">
            <h3 class="admin-product-name">${p.title}</h3>
            <div class="admin-product-meta">
              <span>$${p.price.toFixed(2)}</span>
              <span>${p.category}</span>
              <span>${p.sku}</span>
              ${badges.join(' ')}
            </div>
          </div>
          <div class="admin-product-actions">
            <button class="admin-btn-icon" onclick="editProduct(${i})" title="Edit">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
            </button>
            <button class="admin-btn-icon delete" onclick="deleteProduct(${i})" title="Delete">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
            </button>
          </div>
        </div>
      `;
    }).join('');
  }

  // ===== PRODUCT MODAL =====
  const modal = document.getElementById('product-modal')!;
  const productForm = document.getElementById('product-form')!;
  const modalTitle = document.getElementById('modal-title')!;
  const modalSubmitText = document.getElementById('modal-submit-text')!;

  function openModal(title = 'Add Product', submitText = 'Save Product') {
    modalTitle.textContent = title;
    modalSubmitText.textContent = submitText;
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    modal.style.display = 'none';
    document.body.style.overflow = '';
    productForm.reset();
    (document.getElementById('product-index') as HTMLInputElement).value = '-1';
    document.getElementById('product-image-preview')!.innerHTML = '';
    (document.getElementById('product-in-stock') as HTMLInputElement).checked = true;
    (document.getElementById('product-featured') as HTMLInputElement).checked = false;
  }

  document.getElementById('modal-close-btn')!.addEventListener('click', closeModal);
  document.getElementById('modal-cancel-btn')!.addEventListener('click', closeModal);
  document.querySelector('.admin-modal-backdrop')!.addEventListener('click', closeModal);

  // Add Product
  document.getElementById('add-product-btn')!.addEventListener('click', () => {
    openModal('Add Product', 'Save Product');
  });

  // Auto-slug from title
  document.getElementById('product-title')!.addEventListener('input', (e) => {
    const slugField = document.getElementById('product-slug') as HTMLInputElement;
    const indexField = document.getElementById('product-index') as HTMLInputElement;
    // Only auto-slug for new products
    if (indexField.value === '-1') {
      slugField.value = slugify((e.target as HTMLInputElement).value);
    }
  });

  // Image preview in modal
  document.getElementById('product-image-upload')!.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const base64 = event.target?.result as string;
      document.getElementById('product-image-preview')!.innerHTML = `<img src="${base64}" alt="Preview" />`;
      // Auto-set image path
      const imageField = document.getElementById('product-image') as HTMLInputElement;
      if (!imageField.value) {
        const slugField = document.getElementById('product-slug') as HTMLInputElement;
        const ext = file.name.split('.').pop();
        imageField.value = `/images/products/${slugField.value || 'product'}.${ext}`;
      }
    };
    reader.readAsDataURL(file);
  });

  // Save product form
  productForm.addEventListener('submit', (e) => {
    e.preventDefault();
    const index = parseInt((document.getElementById('product-index') as HTMLInputElement).value);
    const comparePriceVal = (document.getElementById('product-compare-price') as HTMLInputElement).value;
    const tagsVal = (document.getElementById('product-tags') as HTMLInputElement).value;

    const product: any = {
      title: (document.getElementById('product-title') as HTMLInputElement).value,
      slug: (document.getElementById('product-slug') as HTMLInputElement).value,
      description: (document.getElementById('product-description') as HTMLTextAreaElement).value,
      price: parseFloat((document.getElementById('product-price') as HTMLInputElement).value),
      image: (document.getElementById('product-image') as HTMLInputElement).value,
      category: (document.getElementById('product-category') as HTMLInputElement).value,
      sku: (document.getElementById('product-sku') as HTMLInputElement).value,
      inStock: (document.getElementById('product-in-stock') as HTMLInputElement).checked,
      featured: (document.getElementById('product-featured') as HTMLInputElement).checked,
    };

    if (comparePriceVal) product.comparePrice = parseFloat(comparePriceVal);
    if (tagsVal) product.tags = tagsVal.split(',').map((t: string) => t.trim()).filter(Boolean);

    const designerVal = (document.getElementById('product-designer') as HTMLInputElement).value;
    const canvasSizeVal = (document.getElementById('product-canvas-size') as HTMLInputElement).value;
    const meshCountVal = (document.getElementById('product-mesh-count') as HTMLInputElement).value;

    if (designerVal) product.designer = designerVal;
    if (canvasSizeVal) product.canvasSize = canvasSizeVal;
    if (meshCountVal) product.meshCount = meshCountVal;

    // Handle uploaded image - add to uploaded images list
    const imageUpload = document.getElementById('product-image-upload') as HTMLInputElement;
    const previewImg = document.getElementById('product-image-preview')!.querySelector('img');
    if (imageUpload.files?.length && previewImg) {
      const file = imageUpload.files[0];
      uploadedImages.push({
        name: product.image.split('/').pop() || file.name,
        data: (previewImg as HTMLImageElement).src,
        size: file.size,
        folder: '/images/products/',
      });
      renderUploadedImages();
    }

    if (index === -1) {
      products.push(product);
      showToast('Product added successfully!');
    } else {
      products[index] = product;
      showToast('Product updated successfully!');
    }

    renderProducts();
    closeModal();
  });

  // Edit product — exposed globally for onclick handlers
  (window as any).editProduct = function(index: number) {
    const p = products[index];
    (document.getElementById('product-index') as HTMLInputElement).value = String(index);
    (document.getElementById('product-title') as HTMLInputElement).value = p.title;
    (document.getElementById('product-slug') as HTMLInputElement).value = p.slug;
    (document.getElementById('product-description') as HTMLTextAreaElement).value = p.description;
    (document.getElementById('product-price') as HTMLInputElement).value = String(p.price);
    (document.getElementById('product-compare-price') as HTMLInputElement).value = p.comparePrice ? String(p.comparePrice) : '';
    (document.getElementById('product-image') as HTMLInputElement).value = p.image || '';
    (document.getElementById('product-category') as HTMLInputElement).value = p.category;
    (document.getElementById('product-sku') as HTMLInputElement).value = p.sku;
    (document.getElementById('product-tags') as HTMLInputElement).value = p.tags ? p.tags.join(', ') : '';
    (document.getElementById('product-designer') as HTMLInputElement).value = p.designer || '';
    (document.getElementById('product-canvas-size') as HTMLInputElement).value = p.canvasSize || '';
    (document.getElementById('product-mesh-count') as HTMLInputElement).value = p.meshCount || '';
    (document.getElementById('product-in-stock') as HTMLInputElement).checked = p.inStock !== false;
    (document.getElementById('product-featured') as HTMLInputElement).checked = p.featured === true;

    if (p.image) {
      document.getElementById('product-image-preview')!.innerHTML = `<img src="${p.image}" alt="Preview" onerror="this.remove()" />`;
    }

    openModal('Edit Product', 'Update Product');
  };

  // Delete product
  (window as any).deleteProduct = function(index: number) {
    if (confirm(`Are you sure you want to delete "${products[index].title}"?`)) {
      products.splice(index, 1);
      renderProducts();
      showToast('Product deleted.', 'info');
    }
  };

  // Export catalog
  document.getElementById('export-catalog-btn')!.addEventListener('click', () => {
    const dataStr = JSON.stringify(products, null, 2);
    const blob = new Blob([dataStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'catalog.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('Catalog JSON exported!');
  });

  // ===== SITE UPDATES =====
  async function loadUpdates() {
    try {
      const response = await fetch('/data/site-updates.json');
      if (response.ok) {
        const data = await response.json();
        siteUpdates = data.updates || [];
      }
    } catch {
      siteUpdates = [];
    }
    renderUpdates();
  }

  function renderUpdates() {
    const list = document.getElementById('updates-list')!;
    if (siteUpdates.length === 0) {
      list.innerHTML = `
        <div class="admin-empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.376 3.622a1 1 0 0 1 3.002 3.002L7.368 18.635a2 2 0 0 1-.855.506l-2.872.838a.5.5 0 0 1-.62-.62l.838-2.872a2 2 0 0 1 .506-.854z"/></svg>
          <p>No updates yet. Use the form above to log site changes.</p>
        </div>
      `;
      return;
    }

    list.innerHTML = siteUpdates.map((u: any, i: number) => `
      <div class="admin-update-row">
        <div class="admin-update-priority ${u.priority}"></div>
        <div class="admin-update-info">
          <h3 class="admin-update-title-text">${u.title}</h3>
          <p class="admin-update-desc">${u.description}</p>
          <span class="admin-update-date">${u.date} · ${u.priority} priority</span>
        </div>
        <div class="admin-update-actions">
          <button class="admin-btn-icon delete" onclick="deleteUpdate(${i})" title="Remove">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
          </button>
        </div>
      </div>
    `).join('');
  }

  document.getElementById('add-update-btn')!.addEventListener('click', () => {
    const title = (document.getElementById('update-title') as HTMLInputElement).value.trim();
    const description = (document.getElementById('update-description') as HTMLTextAreaElement).value.trim();
    const priority = (document.getElementById('update-priority') as HTMLSelectElement).value;

    if (!title || !description) {
      showToast('Please fill in both title and description.', 'error');
      return;
    }

    siteUpdates.unshift({
      title,
      description,
      priority,
      date: new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
    });

    (document.getElementById('update-title') as HTMLInputElement).value = '';
    (document.getElementById('update-description') as HTMLTextAreaElement).value = '';
    (document.getElementById('update-priority') as HTMLSelectElement).value = 'medium';

    renderUpdates();
    showToast('Update added!');
  });

  (window as any).deleteUpdate = function(index: number) {
    siteUpdates.splice(index, 1);
    renderUpdates();
    showToast('Update removed.', 'info');
  };

  document.getElementById('export-updates-btn')!.addEventListener('click', () => {
    const dataStr = JSON.stringify({ updates: siteUpdates }, null, 2);
    const blob = new Blob([dataStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'site-updates.json';
    a.click();
    URL.revokeObjectURL(url);
    showToast('Site updates exported!');
  });

  // ===== IMAGE UPLOAD =====
  const dropZone = document.getElementById('drop-zone')!;
  const imageFileInput = document.getElementById('image-file-input') as HTMLInputElement;

  // Drag events
  ['dragenter', 'dragover'].forEach(evt => {
    dropZone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropZone.classList.add('drag-over');
    });
  });
  ['dragleave', 'drop'].forEach(evt => {
    dropZone.addEventListener(evt, (e) => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
    });
  });

  dropZone.addEventListener('drop', (e) => {
    const files = (e as DragEvent).dataTransfer?.files;
    if (files) handleImageFiles(files);
  });

  imageFileInput.addEventListener('change', () => {
    if (imageFileInput.files) handleImageFiles(imageFileInput.files);
    imageFileInput.value = '';
  });

  function handleImageFiles(files: FileList) {
    const folder = (document.getElementById('image-subfolder') as HTMLSelectElement).value;
    Array.from(files).forEach(file => {
      if (!file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        uploadedImages.push({
          name: file.name,
          data: e.target?.result as string,
          size: file.size,
          folder,
        });
        renderUploadedImages();
      };
      reader.readAsDataURL(file);
    });
    showToast(`${files.length} image${files.length > 1 ? 's' : ''} added!`);
  }

  function renderUploadedImages() {
    const gallery = document.getElementById('uploaded-images')!;
    if (uploadedImages.length === 0) {
      gallery.innerHTML = `
        <div class="admin-empty-state" style="grid-column: 1 / -1;">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          <p>No images uploaded yet. Drag & drop or click above to start.</p>
        </div>
      `;
      return;
    }

    gallery.innerHTML = uploadedImages.map((img, i) => `
      <div class="admin-image-card">
        <img src="${img.data}" alt="${img.name}" />
        <div class="admin-image-card-info">
          <p class="admin-image-card-name" title="${img.name}">${img.name}</p>
          <p class="admin-image-card-size">${formatBytes(img.size)} · ${img.folder}</p>
          <div class="admin-image-card-actions">
            <button class="admin-image-download-btn" onclick="downloadImage(${i})">Download</button>
            <button class="admin-image-remove-btn" onclick="removeImage(${i})">Remove</button>
          </div>
        </div>
      </div>
    `).join('');
  }

  (window as any).downloadImage = function(index: number) {
    const img = uploadedImages[index];
    const a = document.createElement('a');
    a.href = img.data;
    a.download = img.name;
    a.click();
    showToast(`Downloaded ${img.name}`);
  };

  (window as any).removeImage = function(index: number) {
    uploadedImages.splice(index, 1);
    renderUploadedImages();
    showToast('Image removed.', 'info');
  };

  document.getElementById('download-all-images-btn')!.addEventListener('click', () => {
    if (uploadedImages.length === 0) {
      showToast('No images to download.', 'error');
      return;
    }
    uploadedImages.forEach((img, i) => {
      setTimeout(() => {
        const a = document.createElement('a');
        a.href = img.data;
        a.download = img.name;
        a.click();
      }, i * 500);
    });
    showToast(`Downloading ${uploadedImages.length} image${uploadedImages.length > 1 ? 's' : ''}...`);
  });

  // Initialize uploaded images gallery
  renderUploadedImages();
</script>

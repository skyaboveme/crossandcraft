---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Our Story | Cross & Craft Co."
  description="Learn about Cross & Craft Co. — a premium needlepoint studio creating hand-painted canvases that blend timeless artistry with modern design."
>
  <Header />

  <main style="padding-top: 7rem;">
    <!-- ===== HERO ===== -->
    <section class="relative py-28 px-4 text-center overflow-hidden" style="background: linear-gradient(135deg, var(--color-deep-navy) 0%, var(--color-espresso) 100%);">
      <div class="absolute inset-0" style="opacity: 0.03;"></div>
      <div class="relative z-10 max-w-3xl mx-auto">
        <span class="text-xs tracking-[0.3em] uppercase mb-3 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">Our Story</span>
        <h1 class="text-4xl md:text-6xl mb-4" style="font-family: var(--font-display); color: var(--color-cream);">
          A Thread of <span class="text-gradient">Passion</span>
        </h1>
        <div class="w-16 h-px mx-auto" style="background: linear-gradient(to right, transparent, var(--color-gold), transparent);"></div>
      </div>
    </section>

    <!-- ===== STORY SECTION 1 ===== -->
    <section class="py-20 px-4" style="background-color: var(--color-cream);">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Image placeholder -->
          <div class="aspect-[4/5] flex items-center justify-center " style="background: linear-gradient(135deg, var(--color-linen) 0%, var(--color-warm-gray) 100%);">
            <div class="text-center p-8">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 mx-auto mb-4" style="color: var(--color-taupe);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z" />
              </svg>
              <span class="text-xs uppercase tracking-widest" style="color: var(--color-taupe);">Founder Image</span>
            </div>
          </div>

          <!-- Text -->
          <div>
            <span class="text-xs tracking-[0.3em] uppercase mb-4 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">The Beginning</span>
            <h2 class="text-3xl md:text-4xl mb-6" style="font-family: var(--font-display); color: var(--color-espresso); line-height: 1.2;">
              Born From a Love of <span class="text-gradient">Beautiful Things</span>
            </h2>
            <p class="text-base leading-relaxed mb-5" style="color: var(--color-charcoal); font-family: var(--font-body);">
              Cross & Craft Co. was born from a lifelong love of needlepoint. What began as a personal passion — stitching in quiet moments between family life and creative pursuits — grew into something we felt compelled to share.
            </p>
            <p class="text-base leading-relaxed mb-5" style="color: var(--color-charcoal); font-family: var(--font-body);">
              We believe there's something special in the slow, deliberate act of creating with your hands. Every stitch is a small act of creativity, every finished piece a testament to patience and beauty.
            </p>
            <p class="text-base leading-relaxed" style="color: var(--color-charcoal); font-family: var(--font-body);">
              Our designs draw from rich artistic traditions — chinoiserie, classic florals, collegiate pride, and modern pattern work — reimagined for the modern stitcher.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== VALUES ===== -->
    <section class="py-20 px-4" style="background-color: var(--color-ivory);">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-16">
          <span class="text-xs tracking-[0.3em] uppercase mb-3 inline-block" style="color: var(--color-gold); font-family: var(--font-body);">What We Believe</span>
          <h2 class="text-3xl md:text-4xl mb-4" style="font-family: var(--font-display); color: var(--color-espresso);">
            Our Values
          </h2>
          <div class="w-16 h-px mx-auto" style="background: linear-gradient(to right, transparent, var(--color-gold), transparent);"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center p-8" style="background: white; border: 1px solid var(--color-linen);">
            <div class="text-3xl mb-4">✦</div>
            <h3 class="text-lg font-semibold mb-3" style="font-family: var(--font-display); color: var(--color-espresso);">Passion for Detail</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-charcoal); font-family: var(--font-body);">
              Every canvas is painted with intention. We approach our craft with deep care — believing beauty is worth the time it takes to create.
            </p>
          </div>
          <div class="text-center p-8" style="background: white; border: 1px solid var(--color-linen);">
            <div class="text-3xl mb-4">🎨</div>
            <h3 class="text-lg font-semibold mb-3" style="font-family: var(--font-display); color: var(--color-espresso);">Artisan Quality</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-charcoal); font-family: var(--font-body);">
              We source only the finest materials — Zweigart canvas, Appleton wool, and DMC cotton — because your craft deserves nothing less.
            </p>
          </div>
          <div class="text-center p-8" style="background: white; border: 1px solid var(--color-linen);">
            <div class="text-3xl mb-4">🤝</div>
            <h3 class="text-lg font-semibold mb-3" style="font-family: var(--font-display); color: var(--color-espresso);">Community & Tradition</h3>
            <p class="text-sm leading-relaxed" style="color: var(--color-charcoal); font-family: var(--font-body);">
              Needlepoint has always been communal. We host trunk shows, workshops, and gatherings where stitchers can share in the joy of making together.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="py-20 px-4 text-center" style="background-color: var(--color-deep-navy);">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl md:text-4xl mb-4" style="font-family: var(--font-display); color: var(--color-cream);">
          Begin Your <span class="text-gradient">Masterpiece</span>
        </h2>
        <p class="text-base mb-8" style="color: var(--color-warm-gray); font-family: var(--font-accent); font-style: italic;">
          Browse our collection and find the canvas that speaks to your heart.
        </p>
        <a href="/shop" class="btn-primary">
          <span>Shop the Collection</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

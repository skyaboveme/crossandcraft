---
const navLinks = [
  { label: 'Shop All', href: '/shop' },
  { label: 'New Arrivals', href: '/shop?filter=new' },
  { label: 'University', href: '/shop?category=university' },
  { label: 'Holiday', href: '/shop?category=holiday' },
  { label: 'About', href: '/about' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <!-- Top announcement bar -->
  <div style="background-color: var(--color-espresso); color: var(--color-cream);" class="text-center py-2 text-xs tracking-widest uppercase">
    <span>✦ Free shipping on orders over $150 ✦</span>
  </div>

  <!-- Main nav -->
  <nav class="glass" style="border-bottom: 1px solid var(--color-linen);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="lg:hidden p-2" aria-label="Open menu">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="flex flex-col items-center">
            <span class="text-2xl md:text-3xl tracking-tight" style="font-family: var(--font-display); font-weight: 700; color: var(--color-espresso);">
              Cross <span class="text-gradient">&</span> Craft
            </span>
            <span class="text-[0.6rem] tracking-[0.3em] uppercase" style="font-family: var(--font-body); color: var(--color-taupe);">
              Needlepoint Studio
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden lg:flex items-center gap-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm tracking-wide uppercase hover:opacity-70 transition-opacity duration-200"
              style={`font-family: var(--font-body); font-weight: 500; color: var(--color-charcoal); letter-spacing: 0.06em;`}
            >
              {link.label}
            </a>
          ))}
        </div>

        <!-- Right actions -->
        <div class="flex items-center gap-4">
          <!-- Search -->
          <button id="search-btn" class="p-2 hover:opacity-70 transition-opacity" aria-label="Search">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
            </svg>
          </button>
          <!-- Cart -->
          <button id="cart-btn" class="p-2 hover:opacity-70 transition-opacity relative" aria-label="Cart">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
            </svg>
            <span id="cart-count" class="absolute -top-1 -right-1 w-5 h-5 text-[0.625rem] font-bold rounded-full flex items-center justify-center hidden" style="background-color: var(--color-dusty-rose); color: white;">
              0
            </span>
          </button>
        </div>
      </div>
    </div>
  </nav>

  <!-- Mobile menu drawer -->
  <div id="mobile-menu" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40" id="mobile-menu-overlay"></div>
    <div class="absolute top-0 left-0 bottom-0 w-80 max-w-[85vw] p-8 flex flex-col gap-6 transform -translate-x-full transition-transform duration-300" id="mobile-menu-drawer" style="background-color: var(--color-cream);">
      <button id="mobile-menu-close" class="self-end p-2" aria-label="Close menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
      <nav class="flex flex-col gap-4">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-lg py-2 border-b transition-colors duration-200"
            style={`font-family: var(--font-display); color: var(--color-espresso); border-color: var(--color-linen);`}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menuClose = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuDrawer = document.getElementById('mobile-menu-drawer');
  const menuOverlay = document.getElementById('mobile-menu-overlay');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    requestAnimationFrame(() => {
      menuDrawer?.classList.remove('-translate-x-full');
      menuDrawer?.classList.add('translate-x-0');
    });
  }

  function closeMenu() {
    menuDrawer?.classList.remove('translate-x-0');
    menuDrawer?.classList.add('-translate-x-full');
    setTimeout(() => mobileMenu?.classList.add('hidden'), 300);
  }

  menuBtn?.addEventListener('click', openMenu);
  menuClose?.addEventListener('click', closeMenu);
  menuOverlay?.addEventListener('click', closeMenu);

  // Sticky header background on scroll
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header?.classList.add('shadow-md');
    } else {
      header?.classList.remove('shadow-md');
    }
  });
</script>

---
const currentYear = new Date().getFullYear();

const shopLinks = [
  { label: 'All Products', href: '/shop' },
  { label: 'University', href: '/shop?category=university' },
  { label: 'Pillows', href: '/shop?category=pillows' },
  { label: 'Holiday', href: '/shop?category=holiday' },
  { label: 'Home Decor', href: '/shop?category=home-decor' },
];

const aboutLinks = [
  { label: 'Our Story', href: '/about' },
  { label: 'Finishing Services', href: '/finishing' },
  { label: 'Trunk Shows', href: '/events' },
  { label: 'Wholesale', href: '/wholesale' },
];

const helpLinks = [
  { label: 'Contact Us', href: '/contact' },
  { label: 'Shipping & Returns', href: '/shipping' },
  { label: 'Care Instructions', href: '/care' },
  { label: 'FAQ', href: '/faq' },
];
---

<footer style="background-color: var(--color-espresso); color: var(--color-cream);">
  <!-- Newsletter section -->
  <div style="border-bottom: 1px solid rgba(255,255,255,0.08);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="max-w-xl mx-auto text-center">
        <h3 class="text-2xl md:text-3xl mb-3" style="font-family: var(--font-display); color: var(--color-cream);">
          Join the <span class="text-gradient">Stitching Circle</span>
        </h3>
        <p class="text-sm mb-6" style="color: var(--color-warm-gray); font-family: var(--font-body);">
          Be the first to know about new designs, trunk shows, and exclusive offers.
        </p>
        <form class="flex gap-2 max-w-md mx-auto" id="newsletter-form">
          <input
            type="email"
            placeholder="Your email address"
            class="flex-1 px-4 py-3 text-sm rounded-none"
            style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: var(--color-cream); font-family: var(--font-body);"
            required
          />
          <button type="submit" class="px-6 py-3 text-xs font-semibold tracking-widest uppercase transition-all duration-300 hover:opacity-90" style="background: var(--color-gold); color: var(--color-espresso);">
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Footer links -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Brand -->
      <div>
        <a href="/" class="inline-block mb-4">
          <span class="text-2xl" style="font-family: var(--font-display); font-weight: 700; color: var(--color-cream);">
            Cross <span class="text-gradient">&</span> Craft
          </span>
          <br />
          <span class="text-[0.6rem] tracking-[0.3em] uppercase" style="color: var(--color-taupe);">Needlepoint Studio</span>
        </a>
        <p class="text-sm leading-relaxed mt-4" style="color: var(--color-warm-gray);">
          Curating exquisite hand-painted needlepoint canvases for stitchers who appreciate the art of the needle.
        </p>
      </div>

      <!-- Shop -->
      <div>
        <h4 class="text-xs font-semibold tracking-[0.2em] uppercase mb-6" style="color: var(--color-gold);">Shop</h4>
        <ul class="space-y-3">
          {shopLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:opacity-70 transition-opacity" style="color: var(--color-warm-gray);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- About -->
      <div>
        <h4 class="text-xs font-semibold tracking-[0.2em] uppercase mb-6" style="color: var(--color-gold);">About</h4>
        <ul class="space-y-3">
          {aboutLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:opacity-70 transition-opacity" style="color: var(--color-warm-gray);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Help -->
      <div>
        <h4 class="text-xs font-semibold tracking-[0.2em] uppercase mb-6" style="color: var(--color-gold);">Help</h4>
        <ul class="space-y-3">
          {helpLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm hover:opacity-70 transition-opacity" style="color: var(--color-warm-gray);">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top: 1px solid rgba(255,255,255,0.08);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs" style="color: var(--color-taupe);">
        &copy; {currentYear} Cross &amp; Craft Co. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="/privacy" class="text-xs hover:opacity-70 transition-opacity" style="color: var(--color-taupe);">Privacy</a>
        <a href="/terms" class="text-xs hover:opacity-70 transition-opacity" style="color: var(--color-taupe);">Terms</a>
      </div>
    </div>
  </div>
</footer>
